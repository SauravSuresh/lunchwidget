<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:minWidth="320dp"
    android:padding="24dp">

    <TextView
        android:id="@+id/itemize_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/space_mono"
        android:letterSpacing="0.08"
        android:textColor="#8F8F8F"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/itemize_legend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/space_mono"
        android:letterSpacing="0.08"
        android:textColor="#5A5A5A"
        android:textSize="10sp" />

    <LinearLayout
        android:id="@+id/bill_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/add_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/space_mono"
            android:letterSpacing="0.08"
            android:padding="4dp"
            android:text="@string/add_item"
            android:textColor="#5A5A5A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/scan_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/space_mono"
            android:letterSpacing="0.08"
            android:padding="4dp"
            android:text="@string/scan_item"
            android:textColor="#5A5A5A"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="#2A2A2A" />

    <TextView
        android:id="@+id/items_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/space_mono"
        android:letterSpacing="0.08"
        android:textColor="#8F8F8F"
        android:textSize="11sp" />

    <Button
        android:id="@+id/itemize_done"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/btn_primary"
        android:fontFamily="@font/space_mono_bold"
        android:letterSpacing="0.08"
        android:text="@string/itemize_done"
        android:textColor="#000000"
        android:textSize="14sp" />
</LinearLayout>
</ScrollView>
