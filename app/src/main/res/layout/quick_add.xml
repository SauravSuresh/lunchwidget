<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:minWidth="320dp"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/space_mono"
            android:letterSpacing="0.08"
            android:text="@string/add_expense"
            android:textColor="#8F8F8F"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/sign_minus"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:background="@drawable/chip_on"
            android:fontFamily="@font/space_mono_bold"
            android:gravity="center"
            android:text="−"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/sign_plus"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/chip"
            android:fontFamily="@font/space_mono_bold"
            android:gravity="center"
            android:text="+"
            android:textColor="#5A5A5A"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/expense_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@null"
            android:fontFamily="@font/doto"
            android:textFontWeight="700"
            android:fontVariationSettings="&apos;ROND&apos; 100"
            android:hint="@string/amount_hint"
            android:inputType="numberDecimal"
            android:textColor="#FFFFFF"
            android:textColorHint="#3A3A3A"
            android:textCursorDrawable="@null"
            android:textSize="48sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:background="#2A2A2A" />

        <AutoCompleteTextView
            android:id="@+id/category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/field_bg"
            android:completionThreshold="1"
            android:hint="@string/category_hint"
            android:inputType="text"
            android:padding="14dp"
            android:popupBackground="#141414"
            android:textColor="#FFFFFF"
            android:textColorHint="#5A5A5A"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/field_bg"
            android:hint="@string/note_hint"
            android:inputType="text"
            android:padding="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#5A5A5A"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/split"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/chip"
            android:fontFamily="@font/space_mono_bold"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="@string/split_entry"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_primary"
            android:fontFamily="@font/space_mono_bold"
            android:letterSpacing="0.08"
            android:text="@string/save"
            android:textColor="#000000"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/income_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mode_repayment"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/chip_on"
                android:fontFamily="@font/space_mono_bold"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:text="@string/repayment"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/mode_income"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/chip"
                android:fontFamily="@font/space_mono_bold"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:text="@string/income"
                android:textColor="#5A5A5A"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/mode_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/space_mono"
            android:letterSpacing="0.08"
            android:text="@string/repayment_hint"
            android:textColor="#5A5A5A"
            android:textSize="11sp" />

        <Button
            android:id="@+id/continue_btn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/btn_primary"
            android:fontFamily="@font/space_mono_bold"
            android:letterSpacing="0.08"
            android:text="@string/continue_label"
            android:textColor="#000000"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
